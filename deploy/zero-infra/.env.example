# Уровень 1 — ноль внешних сервисов.
#
# Скопируйте в .env рядом с кодом и запустите:
#     python -m backend.api.app
#
# Ни Postgres, ни Redis, ни Qdrant, ни Neo4j поднимать не нужно. Граф и
# векторы лежат файлами в data/, эмбеддинги считает локальная модель.
# Границы этого режима — в ../README.md, читайте перед установкой.

# ── Хранилища: файловые ────────────────────────────────────────────────
# Обе переменные понимают явное «нет» — раньше USE_QDRANT=false не
# выключал ничего, потому что наличие пакета qdrant-client перевешивало.
USE_NETWORKX=true
USE_QDRANT=false

# Где лежат данные. Каталог должен переживать перезапуск: граф и векторы
# здесь — не кеш, а единственная копия.
GRAPH_STORAGE_PATH=./data/knowledge_graph.json

# ── Модель эмбеддингов ─────────────────────────────────────────────────
# По умолчанию веса тянутся с HuggingFace при первом запуске. В закрытом
# контуре скачайте модель заранее и укажите путь — иначе первый запуск
# уйдёт в режим «без эмбеддингов», и работать будет только BM25.
# LOCAL_EMBEDDING_MODEL=/models/multilingual-e5-base

# ── Модель для ответов ─────────────────────────────────────────────────
# Любой из поддерживаемых провайдеров, либо локальный сервер (vLLM,
# Ollama) через совместимый адрес.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# ── Секрет подписи токенов ─────────────────────────────────────────────
# Для установки на одного человека можно оставить пустым. Для всего
# остального — обязателен: без него строгая аутентификация отключается,
# и запросом с ?user_id= можно действовать от чужого имени.
# JWT_SECRET=

# ── Что здесь НЕ заработает ────────────────────────────────────────────
# Вход в систему и загрузка встреч завязаны на Supabase — это
# единственный путь аутентификации и единственный источник встреч.
# Уровень 1 сегодня — движок памяти и поиска над данными, которые вы
# загрузили сами. Полный продукт «из коробки» — с уровня 2.
# SUPABASE_URL=
# SUPABASE_KEY=
