# ============================================================================
# TESSENT BRAIN — Single-VPS Production Preset
# Скопируйте в .env, заполните и НИКОГДА не коммитьте.
# ============================================================================

# === Домен (для Caddy auto-HTTPS) ===
# DOMAIN — домен API (api.*), APP_DOMAIN — домен веб-интерфейса (app.*).
# Оба должны A-записью указывать на IP этой VPS. Caddy выпишет отдельные
# сертификаты для каждого.
DOMAIN=api.tessent.example.com
APP_DOMAIN=app.tessent.example.com
ACME_EMAIL=ops@example.com

# === Postgres ===
# Сгенерируйте пароль: openssl rand -hex 24
POSTGRES_USER=tessent
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=tessent_brain

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# === Qdrant ===
QDRANT_API_KEY=CHANGE_ME_openssl_rand_hex_24
# Опциональный read-only ключ для UI-дашбордов
QDRANT_READ_ONLY_API_KEY=

# === Neo4j ===
NEO4J_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# === App / JWT ===
# Сгенерируйте: openssl rand -base64 48
SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_base64_48

# === Supabase (автоматизации + команды для MAC/P5) ===
# Без этих двух не работают: scheduler автоматизаций и mandatory-доступ
# (P5 читает команды из таблицы MEETFLOW_TEAMS_TABLE). Оставьте пустыми,
# только если автоматизации/MAC не нужны.
SUPABASE_URL=
SUPABASE_KEY=

# === MeetFlow (обработка встреч) ===
# Путь к коду MeetFlow ВНУТРИ контейнера. Смонтируйте его как volume
# в api/worker (например ./meetflow:/opt/meetflow:ro) или соберите в
# образ. Без него часть обработки встреч/automation_tools_async не идёт.
MEETFLOW_PATH=/opt/meetflow

# === LLM ===
# Один из режимов:
#   1. Cloud: задайте GOOGLE_API_KEY и/или OPENAI_API_KEY (Gemini дешевле).
#   2. On-prem (W8): задайте LLM_LOCAL_BASE_URL + LLM_LOCAL_MODEL,
#      выставьте ENTERPRISE_MODE=true. См. ENTERPRISE.md.
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini

# === Enterprise / on-prem (W8) ===
# Когда ENTERPRISE_MODE=true — managed-ключи (OPENAI/GOOGLE) запрещены,
# LLM_LOCAL_BASE_URL обязан указывать на internal-сеть (vLLM/Ollama/TGI).
# Тем же правилом проверяются профили моделей из БД и личные ключи
# сотрудников: завести облако в обход контура нельзя. Веб-поиск в этом
# режиме отключается (наружу не уходит даже текст запроса), а в ответах
# режутся внешние ссылки и секреты.
ENTERPRISE_MODE=false
LLM_LOCAL_BASE_URL=
LLM_LOCAL_MODEL=
LLM_LOCAL_API_KEY=
# Веса локальной модели эмбеддингов при первом запуске скачиваются с
# HuggingFace. Для полностью изолированного контура положите их в образ
# заранее и укажите путь: LOCAL_EMBEDDING_MODEL=/models/<имя>

# === Исполнители задач ===
# Кодинг: EXECUTOR_BACKEND=openhands + OPENHANDS_BASE_URL (свой сервер,
# единственный кодинг-путь для закрытого контура) или claude_code_cli /
# codex_cli / cursor_cli (подписка, ходят в облако — в контуре запрещены).
# Офис («собери бриф», «письмо с цифрами»): поднимите openworker-server
# и укажите адрес — офисные типы задач начнут уходить туда сами.
# В контуре адрес обязан быть внутренним. Один экземпляр на сотрудника:
# общий на всех схлопнул бы персональные права его коннекторов.
OPENWORKER_BASE_URL=
OPENWORKER_TOKEN=
# Явная карта тип→исполнитель (сильнее дефолтов): landing=openhands,office=openworker
EXECUTOR_TASK_ROUTES=

# === Поиск ===
# Реранкер вторым проходом (кросс-энкодер поверх top-20 гибрида).
# Выключен по умолчанию: новый код + задержка на каждый запрос.
# Модель локальная (по умолчанию BAAI/bge-reranker-base, многоязычная);
# для закрытого контура положите веса в образ и укажите путь.
RERANKER_ENABLED=off
RERANKER_MODEL=
# Усиление графа на перечислительных запросах («покажи всех, кто…») — on.
ENUM_GRAPH_BOOST=on
# Агрегирующий вопрос («сколько всего», «как долго») подтягивает куски
# встреч с попаданиями целиком — измерено: 0.43→0.57 на классе
# «через много разговоров». Добавка помечена и ограничена капом.
AGGREGATE_EXPAND=on
# Лексический канал слоя опыта (второй путь к паттерну, не через вектор) — on.
WISDOM_LEXICAL_CHANNEL=on

# Фильтр на выходе модели. true — полный набор (контакты, реквизиты,
# секреты); маска телефона задевает и обычные числа, поэтому по умолчанию
# выключено. В ENTERPRISE_MODE независимо от флага работает узкий набор:
# секреты и внешние ссылки.
ENABLE_OUTPUT_DLP=false
# Резать внешние ссылки ВНЕ закрытого контура (внутри — режутся всегда).
DLP_REDACT_EXTERNAL_URLS=false

# === Multi-tenant (Phase 7) ===
# По умолчанию false → single-tenant поведение.
# При обслуживании нескольких клиентов на одной VPS — true.
MULTITENANT_STRICT=false
MULTITENANT_STORAGE_STRICT=false

# === Лимиты ===
RATE_LIMIT_USER_PER_MINUTE=60
LLM_USER_DAILY_TOKEN_LIMIT=200000
LLM_TENANT_DAILY_TOKEN_LIMIT=5000000

# === CORS (W6) ===
# Comma-separated список origin'ов, которым разрешён CORS с credentials.
# В проде НИКОГДА не используйте "*" с allow_credentials=True — это CSRF-вектор.
# Пример: "https://app.example.com,https://meetflow.example.com"
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# === Service-to-service JWT (W6) ===
# Shared secret для service-токенов (например, meetflow → tessent_brain).
# Сгенерируйте: openssl rand -base64 48
# Если пустой — service-auth выключен, межсервисные вызовы должны идти под
# обычным user-JWT.
SERVICE_JWT_SECRET=
SERVICE_JWT_AUDIENCE=tessent-brain
SERVICE_JWT_ISSUER=meetflow

# === Backup (опционально) ===
# Если meetflow поднят отдельным docker-compose с собственным Postgres,
# backup.sh заберёт и его дамп. Формат: postgres://user:pass@host/db
MEETFLOW_DATABASE_URL=

# === Roadmap P4–P10 — careful rollout ===
# ВСЕ дефолты безопасны (поведение не меняется). Включать ПОЭТАПНО,
# по одному, наблюдая логи. Подробно: docs/DEPLOYMENT.md
# «Поэтапное включение P4–P10».
#
# P6: онтология для extraction из встреч. off|warn|strict.
#   warn = норма для старта; strict — ТОЛЬКО после зелёного eval-гейта
#   (python -m backend.core.eval с EVAL_LLM_ENABLED=1), иначе порежет
#   корректные «грязные» LLM-данные.
ONTOLOGY_EXTRACTION_MODE=warn
# P5: mandatory/team-доступ. off|warn|strict. С 2026-08 дефолт КОДА —
#   strict (безопасно: непомеченный узел = internal, виден всем; прячется
#   только явно помеченное). Значение здесь держите в согласии с кодом —
#   off в этом файле ВЫКЛЮЧИТ группы доступа при развёртывании по образцу.
MANDATORY_ACCESS_MODE=strict
MEETFLOW_TEAMS_TABLE=team_members
# P7/P8/P9: lineage происхождения узлов/связей. С 2026-08 дефолт кода —
#   on (задним числом происхождение не восстановить). off здесь снова
#   остановит накопление меток.
DATA_LINEAGE_ENABLED=on

# === Hermes-трек (P12 «agent oc») — careful rollout ===
# ВСЁ default off → вкладка agent oc работает как ReAct поверх
# OpenClaw-ядра, остальные механики выключены, дефолт не меняется.
# Порядок включения и смысл — docs/DEPLOYMENT.md «Шаг 12.6».
HERMES_SKILLS_ENABLED=off          # skills_list/skill_view в петле
HERMES_SKILL_AUTOLEARN=off         # автосоздание навыка из траектории
HERMES_LESSONS_ENABLED=off         # память удач/неудач + инжект
HERMES_PORTRAIT_ENABLED=off        # портрет клиента в промпт
HERMES_APPROVAL_MODE=off           # off|observe|enforce (safety-gate)
HERMES_APPROVAL_ALLOW=             # CSV имён инструментов (force-allow)
HERMES_APPROVAL_DENY=              # CSV имён (force-deny)
HERMES_AGENT_TOOLS_ENABLED=off     # skill_manage/delegate/execute_code
HERMES_MAX_STEPS=30                # бюджет ReAct-итераций agent_oc (≤90)
HERMES_REAL_EXECUTION=off          # реальные delegate/execute_code
                                   #  (иначе безопасные заглушки)
HERMES_MCP_ENABLED=off             # внешние MCP tool-серверы
HERMES_MCP_SERVERS=                # JSON {"имя":"команда-запуска"}

# === Тэг образа ===
# Подставляется в docker-compose.yml для api/worker.
# Разработчики обычно ставят latest, прод — конкретный SHA.
IMAGE_TAG=latest
