# Tessbrain — local development configuration.
# Copy to .env and fill in. Never commit .env (it is gitignored).
#
#   cp env.example .env
#
# Every value below is the default the code already uses, so a fresh copy of
# this file runs against `docker compose up -d` with no edits — except the two
# marked REQUIRED.

# === Application ===
APP_ENV=development
DEBUG=true

# === REQUIRED: one model provider key ===
# Without one, extraction and chat cannot run. Set whichever you have.
GOOGLE_API_KEY=
OPENAI_API_KEY=

# === REQUIRED in production: JWT signing key ===
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start in production while this is the default — that is
# deliberate: without a real key, signature verification silently degrades.
JWT_SECRET_KEY=your-jwt-secret-key

# === PostgreSQL — matches docker-compose.yml ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tessent_brain
POSTGRES_USER=tessent
POSTGRES_PASSWORD=tessent_secret
# Or override the whole DSN at once (takes priority over the parts above):
# DATABASE_URL=postgresql+asyncpg://tessent:tessent_secret@localhost:5432/tessent_brain

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Qdrant (vector store) ===
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === Neo4j (graph store) ===
# Optional for a first run: the system falls back to an in-process NetworkX
# graph when Neo4j is unreachable. Set USE_NETWORKX=true to skip it entirely.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret

# === Zero-infrastructure mode (tier 1) ===
# Graph and vectors in local JSON files, no Postgres/Qdrant/Neo4j needed.
# See deploy/README.md for the honest limits of this mode.
# USE_NETWORKX=true
# USE_QDRANT=false

# === Supabase ===
# Login and meeting ingestion currently require a Supabase-compatible stack.
# Documented, not hidden — see deploy/README.md, "the honest limit of tier 1".
SUPABASE_URL=
SUPABASE_KEY=
